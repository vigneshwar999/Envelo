{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server build:vercel && BASE_PATH=/ pnpm --filter @workspace/sealed-invoices build && PORT=5173 BASE_PATH=/demo-video/ pnpm --filter @workspace/demo-video build && mkdir -p artifacts/sealed-invoices/dist/public/demo-video && cp -a artifacts/demo-video/dist/public/. artifacts/sealed-invoices/dist/public/demo-video/",
  "outputDirectory": "artifacts/sealed-invoices/dist/public",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/demo-video/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/demo-video", "destination": "/demo-video/index.html" },
    { "source": "/demo-video/", "destination": "/demo-video/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
